# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional external Forgejo instance (embedded Forgejo-compatible Git/Markdown store is active by default)
FORGEJO_URL=""
FORGEJO_TOKEN=""
FORGEJO_OWNER="school76"

# Optional external Garage S3 instance (embedded Garage S3-compatible object store is active by default)
GARAGE_S3_ENDPOINT=""
GARAGE_S3_REGION="garage"
GARAGE_S3_BUCKET="school76-media"
GARAGE_S3_ACCESS_KEY=""
GARAGE_S3_SECRET_KEY=""

# Optional GitHub sync (used server-side by the Commit & Push to GitHub button)
GITHUB_TOKEN=""
GITHUB_REPO="spawnperm/school76"
GITHUB_BRANCH="main"

# Optional external PostgreSQL instance (embedded PostgreSQL-compatible SQL store is active by default)
POSTGRES_HOST=""
POSTGRES_PORT="5432"
POSTGRES_DB="school76_mission"
POSTGRES_USER=""
POSTGRES_PASSWORD=""

# Optional external Directus, NATS, Dify, and Traefik endpoints
DIRECTUS_URL=""
DIRECTUS_TOKEN=""
NATS_URL=""
DIFY_API_URL=""
DIFY_API_KEY=""
TRAEFIK_ADMIN_URL=""
